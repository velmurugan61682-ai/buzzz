# ==============================================================================
# BUZZZ CLIENT ENVIRONMENT CONFIGURATION (apps/web/.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY RULES FOR CLIENT ENVIRONMENT:
# 1. Variables in this file are bundled with Vite into the public browser build.
# 2. ONLY browser-safe, public variables starting with VITE_ are permitted here.
# 3. NEVER put any private API keys, database URLs, JWT secrets, OAuth client
#    secrets, Stripe secrets, or provider credentials in this file.
#
# ==============================================================================

# Backend API endpoint URL (Used by Vite dev proxy and client fetches)
VITE_API_URL=http://localhost:4000

# Public application base URL
VITE_APP_URL=http://localhost:5173

# Application display name
VITE_APP_NAME=BUZZZ

# Optional analytics flag (true/false)
VITE_ENABLE_ANALYTICS=false
