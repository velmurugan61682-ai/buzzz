# ==============================================================================
# BUZZZ PLATFORM — ROOT WORKSPACE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
#
# Monorepo Structure:
# - Frontend: apps/web (Uses apps/web/.env with VITE_ variables)
# - Backend:  services/api (Uses services/api/.env with private variables)
#
# Docker Compose & Local Development Reference Defaults:
# ==============================================================================

# Node Environment
NODE_ENV=development

# Services Ports
PORT=4000
WEB_PORT=5173

# URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000

# Database & Redis (Local Docker-Compose defaults)
DATABASE_URL=postgres://buzzz:buzzz@localhost:5432/buzzz
MONGODB_URI=
REDIS_URL=redis://localhost:6379

# Local Security Key Defaults
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
