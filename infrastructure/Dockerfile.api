FROM node:20-alpine
WORKDIR /app
COPY services/api/package.json ./
RUN npm install --omit=dev
COPY services/api/src ./src
ENV NODE_ENV=production
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:4000/health >/dev/null || exit 1
USER node
CMD ["node", "src/index.js"]
