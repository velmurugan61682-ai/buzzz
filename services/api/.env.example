# ==============================================================================
# BUZZZ SERVER ENVIRONMENT CONFIGURATION (services/api/.env.example)
# ==============================================================================
#
# IMPORTANT SECURITY RULES FOR SERVER ENVIRONMENT:
# 1. This file contains private server configuration, database credentials, and
#    integration secrets. It must NEVER be committed to Git or sent to a browser.
# 2. Never log or print secret values at runtime.
# 3. Customer BYOK (Bring Your Own Key) credentials are NEVER stored in .env;
#    they are submitted via UI and stored encrypted in the database.
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME (REQUIRED)
# ------------------------------------------------------------------------------
# Node runtime environment ('development', 'test', 'production')
NODE_ENV=development

# HTTP server port
PORT=4000

# Public frontend application URL
APP_URL=http://localhost:5173

# Public backend API URL
API_URL=http://localhost:4000

# Public ngrok / tunnel URL for local webhook testing (e.g. https://xxxx.ngrok-free.app)
API_PUBLIC_URL=

# Comma-separated list of allowed CORS origins (Wildcard '*' is forbidden with credentials)
ALLOWED_ORIGINS=https://buzzzbuzzz.com,https://app.buzzzbuzzz.com,http://localhost:5173

# Optional log level: 'silent', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE & REDIS (REQUIRED / RECOMMENDED)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL with Row-Level Security & pgvector support
DATABASE_URL=postgres://buzzz:buzzz@localhost:5432/buzzz

# Maximum connection pool size
PG_POOL_MAX=10

# MongoDB Connection URI (Atlas or standalone MongoDB)
MONGODB_URI=

# Redis URL for background queues, rate limits, and pub/sub caching (OPTIONAL)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY SECRETS (REQUIRED IN PRODUCTION)
# ------------------------------------------------------------------------------
# Secret for signing and verifying customer session JWTs
JWT_SECRET=your-jwt-secret-at-least-32-chars-long

# Secret for refresh tokens
JWT_REFRESH_SECRET=your-refresh-token-secret-at-least-32-chars-long

# Cookie session secret
SESSION_SECRET=your-session-cookie-secret-key

# Symmetric 256-bit key (hex/base64) for encrypting stored OAuth refresh tokens
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Master encryption key for workspace BYOK secrets at rest
CREDENTIAL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDERS (MANAGED WORKSPACE ACCOUNTS) (OPTIONAL)
# ------------------------------------------------------------------------------
# OpenRouter master API key for managed LLM inference
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# Fallback direct OpenAI key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=openai/gpt-4o-mini

# Fallback direct Anthropic key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# ------------------------------------------------------------------------------
# 5. GOWHATS — WHATSAPP BUSINESS INTEGRATION (OPTIONAL)
# ------------------------------------------------------------------------------
GOWHATS_BASE_URL=https://api.gowhats.app
GOWHATS_API_KEY=gowhats_live_api_key
GOWHATS_WEBHOOK_SECRET=gowhats_webhook_signing_secret

# ------------------------------------------------------------------------------
# 6. MRASSISTANT.AI — VOICE AGENTS & CALLING (OPTIONAL)
# ------------------------------------------------------------------------------
MRASSISTANT_BASE_URL=https://api.mrassistant.ai
MRASSISTANT_API_KEY=mrassistant_api_key
MRASSISTANT_CLIENT_ID=mrassistant_oauth_client_id
MRASSISTANT_CLIENT_SECRET=mrassistant_oauth_client_secret
MRASSISTANT_WEBHOOK_SECRET=mrassistant_webhook_secret

# ------------------------------------------------------------------------------
# 7. GOOGLE & SOCIAL OAUTH (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Calendar & Meet integration
GOOGLE_CLIENT_ID=google-calendar-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google-calendar-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/google/callback
GOOGLE_WEBHOOK_URL=http://localhost:4000/api/v1/google/webhook

# Social Sign-in OAuth
GOOGLE_OAUTH_CLIENT_ID=google-signin-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=google-signin-client-secret

APPLE_OAUTH_CLIENT_ID=com.buzzz.web.signin
APPLE_OAUTH_CLIENT_SECRET=apple-service-private-key-secret

# ------------------------------------------------------------------------------
# 8. STRIPE — PAYMENTS & SUBSCRIPTION BILLING (OPTIONAL)
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ------------------------------------------------------------------------------
# 9. S3 COMPATIBLE OBJECT STORAGE (OPTIONAL)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=buzzz-media-storage
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# ------------------------------------------------------------------------------
# 10. SMTP / EMAIL DELIVERY (OPTIONAL)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-or-smtp-password
EMAIL_FROM=notifications@buzzzbuzzz.com

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY & MONITORING (OPTIONAL)
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
GIT_SHA=dev
