<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- HARD CONSTRAINED PERMISSIONS ONLY -->
    <!-- READ_PHONE_STATE: Detect incoming/missed call state transitions via TelephonyManager -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- READ_CALL_LOG: Access call log entry for missed call timestamps and caller info -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- READ_CONTACTS: Match caller phone number against saved Android Contacts for display name and linked email -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- INTERNET: Sync missed call events securely over HTTPS to BUZZZ backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="BUZZZ Companion"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BroadcastReceiver for telephony state changes -->
        <receiver
            android:name=".receiver.MissedCallReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
