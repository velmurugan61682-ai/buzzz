{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@web/*": ["apps/web/src/*"],
      "@api/*": ["services/api/src/*"]
    }
  },
  "include": ["apps/**/*", "services/**/*", "scripts/**/*"],
  "exclude": ["node_modules", "**/dist"]
}
